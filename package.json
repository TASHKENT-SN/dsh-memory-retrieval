{
  "name": "dsh-memory-retrieval",
  "version": "0.9.68",
  "description": "Local keyword retrieval over a full memory JSONL, injected as relevance-gated candidates into DSH prompts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./retrieval": "./lib/retrieval.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "menu.mjs",
    "memory.example.jsonl",
    "README.md",
    "LICENSE",
    "synonyms.example.json",
    "tools"
  ],
  "bin": {
    "dsh-memory-retrieval-menu": "./menu.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "retrieval"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TASHKENT-SN/dsh-memory-retrieval.git"
  },
  "homepage": "https://github.com/TASHKENT-SN/dsh-memory-retrieval#readme",
  "bugs": {
    "url": "https://github.com/TASHKENT-SN/dsh-memory-retrieval/issues"
  },
  "scripts": {
    "test": "sh scripts/test-all.sh",
    "hooks:install": "node scripts/install-hooks.mjs"
  }
}
